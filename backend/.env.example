# Copie este arquivo para .env e preencha os valores
PORT=3000

# Opção 1 (recomendada): connection string única
DATABASE_URL=postgresql://usuario:senha@localhost:5432/fitzreview

# Opção 2: variáveis individuais (usadas se DATABASE_URL estiver vazia)
DB_USER=postgres
DB_HOST=localhost
DB_PASSWORD=sua_senha
DB_NAME=fitzreview
DB_PORT=5432

# Obrigatório para busca e detalhes de livros (Google Books API)
GOOGLE_BOOKS_API_KEY=
